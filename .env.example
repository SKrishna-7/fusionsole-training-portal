# ==============================================================================
# FUSIONSOLE LEARNING PORTAL - SUPABASE CONFIGURATION
# ==============================================================================
#
# Follow these steps to connect your Supabase project:
# 1. Sign up / Log in to https://supabase.com (Free Tier)
# 2. Create a new project (e.g. "fusionsole-learning")
# 3. Go to Project Settings -> API
# 4. Copy the Project URL and anon / public API key
# 5. Run the SQL migrations located in ./supabase/migrations/ in the Supabase SQL Editor:
#      - 001_initial_schema.sql
#      - 002_seed_data.sql
#      - 003_storage_and_helpers.sql
# 6. Copy this file to .env and fill in the values below:
#      cp .env.example .env
#
# Vite Frontend Variables (Accessible in browser):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Framework compatibility alias (Supported by our client layer):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-Side Only / Edge Functions (NEVER expose to browser client code):
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key_here
